{
  "name": "desktop",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.js",

  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },

  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },

  "build": {
    "appId": "com.anci.desktop",
    "productName": "ANCI",

    "directories": {
      "output": "dist"
    },

    "files": [
      "src/**/*",
      "package.json"
    ],

    "win": {
      "target": "nsis"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}