{
  "name": "desktop",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "prepare:admin": "node scripts/prepare-admin.js",
    "build": "pnpm --dir ../admin build && node scripts/prepare-admin.js && electron-builder",
    "build:win": "pnpm --dir ../admin build && node scripts/prepare-admin.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.anci.desktop",
    "productName": "ANCI",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/admin-server",
        "to": "admin-server"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "ANCI-Setup-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ANCI"
    }
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23"
  }
}
