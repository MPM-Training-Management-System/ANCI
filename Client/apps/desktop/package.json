{
  "name": "desktop",
  "version": "0.1.0",
  "main": "electron/main.ts",
  "private": true,
   "build": {
    "appId": "com.anci.desktop",
    "productName": "ANCI",
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "scripts": {
      "dev": "concurrently -k \"next dev --port 3001\" \"wait-on http://localhost:3001 && electron electron/main.ts\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "electron": "^43.2.0",
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
     "@repo/api": "workspace:*",
      "@repo/utils": "workspace:*",
     "@repo/types": "workspace:*",
    "@repo/hooks": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/token": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
