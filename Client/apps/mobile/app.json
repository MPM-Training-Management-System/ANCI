{
  "expo": {
    "name": "ANCi",
    "slug": "mobile1",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/ANCILOGO.png",

    "scheme": "mobile1",

    "userInterfaceStyle": "automatic",

    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "edgeToEdgeEnabled": true,

      "predictiveBackGestureEnabled": false,

      "package": "com.anonymous.mobile1"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ANCILOGO.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000",

          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ANCI to use Face ID to securely sign you in."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},

      "eas": {
        "projectId": "2e9c4f81-11b9-4497-aef6-d8420fdb559f"
      }
    }
  }
}